HUGGINGFACE_TOKEN=
GEMINI_API_KEY=
# Server defaults to the same named database as firebase-applet-config.json.
# Override only when the frontend Firebase configuration uses this database too.
FIRESTORE_DATABASE_ID=

# Apple ID of the iOS app (the number in https://apps.apple.com/app/id123456789).
# Needed for the in-app update prompt on iOS; leave empty until the app is on the App Store.
VITE_IOS_APP_STORE_ID=
