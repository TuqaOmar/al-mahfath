rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roleName) {
      return isSignedIn() && (
        currentUserData().role == roleName ||
        ('roles' in currentUserData() &&
          roleName in currentUserData().roles &&
          currentUserData().roles[roleName] == true)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAssignedTeacher(studentId) {
      let memberPath = /databases/$(database)/documents/memberships/$(studentId);
      return isTeacher() && exists(memberPath) && validTeacherMembership(get(memberPath).data, studentId);
    }

    function validTeacherMembership(member, studentId) {
      return member.keys().hasAll(['uid', 'status', 'groupId', 'teacherId']) &&
        member.uid == studentId && member.status == 'active' &&
        member.teacherId == request.auth.uid && member.groupId is string &&
        member.groupId.size() > 0 && member.groupId.matches('^[^/]+$') &&
        exists(/databases/$(database)/documents/groups/$(member.groupId)) &&
        get(/databases/$(database)/documents/groups/$(member.groupId)).data.teacherId == request.auth.uid &&
        (!('active' in get(/databases/$(database)/documents/groups/$(member.groupId)).data) ||
          get(/databases/$(database)/documents/groups/$(member.groupId)).data.active != false);
    }

    function isSafeInitialUser(userId) {
      return isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'photoURL', 'hasCompletedWizard',
          'role', 'roles', 'streak', 'xp', 'level',
          'memorizedPagesCount', 'memoryScore', 'totalJuz',
          'preferences', 'createdAt'
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'user' &&
        request.resource.data.roles == {'user': true} &&
        request.resource.data.streak == 0 &&
        request.resource.data.xp == 100 &&
        request.resource.data.level == 1 &&
        request.resource.data.memorizedPagesCount == 0 &&
        request.resource.data.memoryScore == 100 &&
        request.resource.data.totalJuz == 0 &&
        request.resource.data.hasCompletedWizard == false;
    }

    function isSafeProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'photoURL', 'preferences', 'favorites', 'fortressPlan'
      ]);
    }

    function isSafeOnboardingUpdate() {
      return resource.data.hasCompletedWizard == false &&
        request.resource.data.hasCompletedWizard == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoURL', 'preferences', 'favorites', 'fortressPlan',
          'hasCompletedWizard'
        ]);
    }

    match /users/{userId} {
      allow create: if isSafeInitialUser(userId) || isAdmin();
      allow read: if isOwner(userId) || isAdmin() || isAssignedTeacher(userId);
      allow update: if (isAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'groupId', 'groupName', 'teacherId', 'teacherName', 'isSafarMember',
            'memorizedPages', 'memorizedPagesCount', 'totalJuz', 'memoryScore'
          ])) ||
        (isOwner(userId) && (isSafeProfileUpdate() || isSafeOnboardingUpdate()));
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /teacher_notes/{noteId} {
        allow read: if isOwner(userId) || isAdmin() ||
          isAssignedTeacher(userId);
        allow write: if false;
      }

      match /ayah_progress/{ayahId} {
        allow read: if isOwner(userId) || isAdmin() ||
          isAssignedTeacher(userId);
        allow create, update: if isOwner(userId) && request.resource.data.userId == userId &&
          request.resource.data.surahNumber is int && request.resource.data.surahNumber >= 1 && request.resource.data.surahNumber <= 114 &&
          request.resource.data.ayahNumber is int && request.resource.data.ayahNumber >= 1 && request.resource.data.ayahNumber <= 286 &&
          request.resource.data.status in ['unmemorized', 'learning', 'review', 'memorized'] &&
          request.resource.data.keys().hasOnly(['userId', 'surahNumber', 'ayahNumber', 'status', 'source', 'updatedAt',
            'globalAyahNumber', 'repetitionCount', 'recitationScore', 'lastReviewed', 'notes']);
        allow delete: if isOwner(userId);
      }

      match /private_ai_chat/{chatId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /five_fortresses_plans/{planId} {
        allow read: if isOwner(userId);
        // Plan and profile completion projection must commit together via API.
        allow write: if false;
      }
      match /{subcollection}/{document=**} {
        allow read: if !(subcollection in ['notifications', 'private_ai_chat', 'five_fortresses_plans']) && (isOwner(userId) || isAdmin() ||
          isAssignedTeacher(userId));
        // Server-computed practice sessions and their atomic aggregates cannot
        // be forged through client writes, including administrative clients.
        allow write: if !(subcollection in ['recitation_sessions', 'recitation_stats', 'page_progress', 'notifications', 'teacher_notes', 'ayah_progress', 'private_ai_chat', 'five_fortresses_plans']) &&
          (isOwner(userId) || isAdmin());
      }
    }

    match /community_posts/{postId} {
      allow read, write: if false;
      match /{subcollection}/{document=**} {
        allow read, write: if false;
      }
    }

    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      // Group writes go through the API to keep memberships and counters atomic.
      allow write: if false;
    }

    match /memberships/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
        isAssignedTeacher(userId);
      allow write: if false;
    }

    match /enrollmentRequests/{requestId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.submittedBy == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
